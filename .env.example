# =============================================================================
# DefesAi — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# =============================================================================

# =============================================================================
# SUPABASE
# =============================================================================
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_ACCESS_TOKEN="sbp_your-access-token"

# Supabase client-side (Vite)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# =============================================================================
# CLOUDFLARE
# =============================================================================
CLOUDFLARE_ACCOUNT_ID="your-account-id"
CLOUDFLARE_API_TOKEN="your-api-token"

# =============================================================================
# AI PROVIDERS
# =============================================================================

# NVIDIA (NIM API)
NVIDIA_API_KEY="nvapi-your-key"

# 9Router (AI Gateway)
NINEROUTER_KEY="sk-your-key"
NINEROUTER_URL="https://api.9router.com"

# Gemini (Google AI)
GEMINI_API_KEY="your-gemini-key"

# xAI (Grok)
XAI_API_KEY="xai-your-key"

# =============================================================================
# OCR — Traffic Ticket Image Recognition
# =============================================================================
# OCR.space — FREE 25,000 requests/month, no credit card required
# Register at: https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY="your-ocr-space-key"

# Google Cloud Vision — FREE 1,000 requests/month (requires GCP project)
# Enable at: https://console.cloud.google.com/apis/library/vision.googleapis.com
GOOGLE_CLOUD_VISION_API_KEY="your-google-vision-key"

# =============================================================================
# WHATSAPP — Evolution API (Self-hosted)
# =============================================================================
# Setup: cd infra/docker && docker compose -f docker-compose.whatsapp.yml up -d
# Docs: https://doc.evolution-api.com/
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="your-evolution-api-key"
EVOLUTION_INSTANCE_NAME="defesai"
EVOLUTION_INSTANCE_PHONE="5511999998888"

# =============================================================================
# EMAIL — Resend (Transactional)
# =============================================================================
# Resend free tier: 100 emails/day (3,000/month)
# Register at: https://resend.com
RESEND_API_KEY="re_your-api-key"
EMAIL_FROM_ADDRESS="noreply@defesai.com.br"
EMAIL_FROM_NAME="DefesAi"

# =============================================================================
# PUSH NOTIFICATIONS — Firebase Cloud Messaging (FCM)
# =============================================================================
# FCM is COMPLETELY FREE — no per-notification cost, unlimited sends
# Setup: https://console.firebase.google.com
# 1. Create project → Settings → Service Accounts → Generate new private key
# 2. For web: Settings → Cloud Messaging → Web Push certificates → Generate key pair
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com"
FIREBASE_VAPID_KEY="your-vapid-public-key"

# =============================================================================
# PAGBANK — Payment Gateway (PIX + Credit Card)
# =============================================================================
# Sandbox: test with fake data
# Production: real payments (requires PagBank account approval)
PAGBANK_TOKEN="your-pagbank-token"
PAGBANK_ENV="sandbox"  # Change to "production" for live payments
PAGBANK_WEBHOOK_SECRET="your-webhook-hmac-secret"

# =============================================================================
# GGPAYPIX — Alternative PIX Gateway
# =============================================================================
PAYMENT_ACTIVE_GATEWAY="pagbank"  # 'pagbank' or 'ggpixapi'
GGPIX_ENABLED="false"
GGPIX_API_KEY="gk_your-ggpix-key"

# =============================================================================
# META — Facebook/Instagram Marketing API
# =============================================================================
# Setup: https://developers.facebook.com
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
META_REDIRECT_URI="https://defesai.com.br/api/integrations/meta/callback"
META_API_VERSION="v20.0"
META_WEBHOOK_VERIFY_TOKEN="your-random-token"

# =============================================================================
# APPLICATION
# =============================================================================
APP_URL="https://defesai.com.br"
NODE_ENV="development"  # 'development' or 'production'
LOG_LEVEL="INFO"  # DEBUG, INFO, WARN, ERROR

# =============================================================================
# DEMO CREDENTIALS (Development only)
# =============================================================================
# These work only in development mode
ADMIN_TEST_LOGIN="admin@defesai.com.br"
ADMIN_TEST_PASSWORD="admin123"
USER_TEST_LOGIN="motorista@defesai.com.br"
USER_TEST_PASSWORD="123456"
